{
  "testMode": true,
  "waterfall": [
    "admob",
    "unity",
    "inmobi"
  ],
  "preload": {
    "formats": [
      "interstitial",
      "rewarded"
    ]
  },
  "frequencyCaps": {
    "interstitial": {
      "maxShows": 3,
      "perSeconds": 3600
    }
  },
  "networks": {
    "admob": {
      "appId": {
        "android": "ca-app-pub-xxxxxxxxxxxxxxxx~yyyyyyyyyy",
        "ios": "ca-app-pub-xxxxxxxxxxxxxxxx~zzzzzzzzzz"
      },
      "bannerAdUnitId": "your-banner-unit",
      "interstitialAdUnitId": "your-interstitial-unit",
      "rewardedAdUnitId": "your-rewarded-unit"
    },
    "unity": {
      "appId": "your-game-id",
      "bannerAdUnitId": "Banner_Android",
      "interstitialAdUnitId": "Interstitial_Android",
      "rewardedAdUnitId": "Rewarded_Android"
    },
    "inmobi": {
      "appId": "your-account-id",
      "bannerAdUnitId": "1234567890",
      "testMode": false
    }
  }
}
